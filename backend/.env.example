# ---------------------------------------------------------------------------
# HealthPlate backend env
# Copy to `.env` and fill in. Every value below has a working default EXCEPT
# MONGODB_URI (optional) and JWT_SECRET (must be set in production).
# ---------------------------------------------------------------------------

PORT=5000
NODE_ENV=development

# Leave EMPTY to run the built-in in-memory MongoDB (great for a demo on a
# fresh machine). Paste a MongoDB Atlas connection string to use a real cluster:
#   mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/healthplate
MONGODB_URI=

# Change this in production. The server refuses to start in production with the
# default value.
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins for CORS.
CLIENT_URL=http://localhost:5173

# OPTIONAL. Leave empty to use the 30 seeded restaurants only.
# Add a key to additionally pull live restaurant data from Google Places.
GOOGLE_PLACES_API_KEY=

# Fallback map centre (Andheri West, Mumbai) used when the browser denies
# geolocation.
DEFAULT_LAT=19.1197
DEFAULT_LNG=72.8464
