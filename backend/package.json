{
  "name": "healthplate-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "HealthPlate API - restaurant discovery filtered by health condition",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:seed": "node scripts/dev.js",
    "seed": "node scripts/seed.js",
    "seed:fresh": "node scripts/seed.js --drop",
    "smoke": "node scripts/smoke.js",
    "verify": "node scripts/verifyLive.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb-memory-server": "^10.0.0",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0"
  },
  "engines": {
    "node": ">=18"
  }
}
